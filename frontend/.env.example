# Base path where the frontend is hosted on the domain (e.g. /interns/ or /)
VITE_BASE_PATH=/interns/

# Base URL for API requests. 
# Leave empty or set to /interns to make same-domain relative calls (recommended when behind reverse proxy)
# Or set to full backend URL (e.g. https://api.datayugsociety.org) if running on separate subdomain/server
VITE_API_BASE=/interns
